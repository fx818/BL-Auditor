# Shared LLM credentials — used by retail / price / buyer_profile /
# retail_agent_2 / isq_validation agents alike.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=60

# --- Windmill small agents (title-category / title-specs / specs-category mismatch) ---
WINDMILL_KEY=    # Bearer token for Windmill API
WINDMILL_BASE_URL=https://windmill.intermesh.net/api/w/indiamart-workspace
WINDMILL_BATCH_FLOW_PATH=u/<user>/Auditor_Batch

# Directory for writable CSV data files (audit_traces.csv, audit_dashboard_log.csv).
# In production set to /app (container working dir). Do NOT use /tmp — data is lost on restart.
DATA_DIR=

# --- RabbitMQ consumer (app/consumer.py) ---
# Only needed by the worker process, not the FastAPI UI.
RABBITMQ_URL=amqp://user:pass@-------/astbuy
RABBITMQ_QUEUE=BL_AUDITOR
RABBITMQ_PREFETCH=1
AUDIT_API_URL=http://------:8000/audit
MAX_RETRIES=3
AUDIT_HTTP_TIMEOUT=180
CONSUMER_STARTUP_DELAY=15  # seconds to wait for FastAPI before consuming (0 to disable locally)
LOG_LEVEL=INFO

# Audit budget & sampling (consumer never stops; audits a fixed quota per day).
MAX_OFFERS=1000          # max offers audited per calendar day; rest are acked & discarded
AUDIT_SAMPLE_EVERY=10    # audit the 1st of every N valid offers (1 = audit all)
AUDIT_DAY_TZ=Asia/Kolkata  # tz for the daily reset boundary (midnight)
AUDIT_HOUR_START=9       # start of active audit window (inclusive, IST hour, 0-23)
AUDIT_HOUR_END=22        # end of active audit window (exclusive, IST hour, 0-23)

# --- Buyer Profile agent (prev BuyLeads + prev enquiries + user detail) ---
# All three APIs authenticate with one shared AK; hosts default to staging.
PREV_LEADS_API_BASE_URL=http://stg-leads.imutils.com
USER_DETAIL_API_BASE_URL=http://stg-users.imutils.com
BUYER_PROFILE_MAX_RETRIES=2
ACCESS_TOKEN=    # shared AK (JWT). Sensitive; IP-bound — do not commit a real token

# --- Google login (auth gate; app refuses to boot without the first three) ---
# Create a Web-application OAuth 2.0 Client ID in Google Cloud;
# authorized redirect URI = <OAUTH_REDIRECT_BASE_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=ksdmfxxxxxxxxxxxxxxbkjcnzxkjvbrkjdfvkjbdfvbrej          # random secret; signs the session cookie. Do not commit a real value
OAUTH_REDIRECT_BASE_URL=http://localhost:8000              # e.g. http://localhost:8080 (local) or https://<host> (prod)
ALLOWED_EMAIL_DOMAINS=indiamart.com,intermesh.net
TRUSTED_INGEST_CIDRS=127.0.0.1/32,::1/128   # peers allowed to POST /audit without login
SESSION_MAX_AGE=604800                       # session lifetime in seconds (7 days)
ADMIN_EMAIL=admin@admin.com                  # admin-login email (session identity for the password login)
ADMIN_PASSWORD=passhere                      # admin-login password; USE A STRONG VALUE in real deployments
REDASH_QUERY_ID=42038
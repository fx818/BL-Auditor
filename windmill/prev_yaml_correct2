    - id: u
      value:
        lock: |
          # py: 3.12
        type: rawscript
        content: >
          import json

          from typing import Any



          def _parse(value: Any) -> Any:
              if isinstance(value, str):
                  text = value.strip()
                  if text:
                      try:
                          return json.loads(text)
                      except Exception:
                          return value
              return value


          def main(x: Any):
              parsed = _parse(x)

              if isinstance(parsed, dict):
                  summary = parsed.get("summary") or {}
                  buyer_viewed = summary.get("buyer_viewed") or {}
                  return {
                      "verdict": parsed.get("verdict"),
                      "reasoning": parsed.get("reasoning"),
                      "buyer_activity": parsed.get("buyer_activity"),
                      "buyer_activity_reason": parsed.get("buyer_activity_reason"),
                      "summary": {
                          "title_mcat": summary.get("title_mcat"),
                          "spec_mcat": summary.get("spec_mcat"),
                          "title_spec": summary.get("title_spec"),
                          "inter_isq": summary.get("inter_isq"),
                          "description": summary.get("description"),
                          "buyer_viewed": {
                              "genuineness": buyer_viewed.get("genuineness"),
                              "product_match": buyer_viewed.get("product_match"),
                          },
                      },
                  }

              return parsed
        language: python3
        input_transforms:
          x:
            expr: results.t.output
            type: javascript

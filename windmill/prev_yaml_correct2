                    # import wmill


                    def main(name: str, company: str, email: str, phone: str,
                    country: str) -> dict:
                        # Safely convert to string and strip whitespace to prevent crashes if None is passed
                        name = str(name or "").strip()
                        company = str(company or "").strip()
                        email = str(email or "").strip()
                        phone = str(phone or "").strip()
                        country = str(country or "").strip()

                        reasons = []

                        # Check 1: Either Name OR Company must be present
                        if not name and not company:
                            reasons.append("Either 'name' or 'company' must be provided.")

                        # Check 2: Name rules (if provided)
                        if name:
                            if len(name) < 2:
                                reasons.append("Name must be at least 2 characters long.")
                            if len(name.split()) > 4:
                                reasons.append("Name must not exceed 4 words.")

                        # Check 3: Company rules (if provided)
                        if company:
                            if len(company) < 2:
                                reasons.append("Company name must be at least 2 characters long.")
                            if len(company.split()) > 4:
                                reasons.append("Company name must not exceed 4 words.")

                        # Check 4: Country-specific contact requirements
                        is_indian = country.lower() in ["india", "indian", "in"]

                        if is_indian:
                            if not phone:
                                reasons.append("Mobile number is mandatory for Indian profiles.")
                        else:
                            if not email:
                                reasons.append("Email is mandatory for foreign profiles.")

                        # Valid is True only when no validation reasons exist
                        return {
                            "valid": len(reasons) == 0,
                            "reasons": reasons,
                            "profile": {
                                "name": name,
                                "company": company,
                                "email": email,
                                "phone": phone,
                                "country": country
                            }
                        }

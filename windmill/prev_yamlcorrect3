    - id: u
      value:
        type: rawscript
        content: >-
          import json

          from typing import Any


          # The recheck agent (y1) is inconsistent about which naming convention
          it

          # echoes back in its "Agent" field -- sometimes the internal
          doc-example

          # names ("Title_category_mismatch", "Specs_category_mismatch", ...)
          and

          # sometimes the same friendly names it was given via Incorrect_agent

          # ("Title vs MCAT Agent", "ISQ vs MCAT Agent", ...). Normalize both

          # conventions down to the canonical friendly name (the one used as
          keys

          # in the Parsing (w) node) so matching works either way.

          def _normalize_key(s: str) -> str:
              return "".join(ch for ch in str(s).lower() if ch.isalnum())


          AGENT_ALIASES = {
              _normalize_key("Title_category_mismatch"): "Title vs MCAT Agent",
              _normalize_key("Title vs MCAT Agent"): "Title vs MCAT Agent",
              _normalize_key("Title_specs_mismatch"): "Title ISQ Agent",
              _normalize_key("Title ISQ Agent"): "Title ISQ Agent",
              _normalize_key("Specs_category_mismatch"): "ISQ vs MCAT Agent",
              _normalize_key("ISQ vs MCAT Agent"): "ISQ vs MCAT Agent",
              _normalize_key("Inter_ISQ"): "Inter ISQ Agent",
              _normalize_key("Inter ISQ Agent"): "Inter ISQ Agent",
          }



          def _canonical_agent_name(raw_name: Any) -> str:
              return AGENT_ALIASES.get(_normalize_key(raw_name), str(raw_name))


          def _parse(value: Any) -> Any:
              if isinstance(value, str):
                  text = value.strip()
                  if text:
                      try:
                          return json.loads(text)
                      except Exception:
                          return value
                  return value
              return value


          def _extract_verdict_reasoning(payload: Any):
              """
              Best-effort extraction of (verdict, reasoning) from a w-node agent
              payload -- the shape differs slightly per agent type (status-based,
              classification-based, valid/reasons-based, or informational-only).
              """
              if not isinstance(payload, dict):
                  return None, None

              if "status" in payload:
                  return payload.get("status"), payload.get("reason")

              if "classification" in payload:
                  return payload.get("classification"), payload.get("reason")

              if "valid" in payload:
                  valid = payload.get("valid")
                  if valid is True:
                      verdict = "Correct"
                  elif valid is False:
                      verdict = "Incorrect"
                  else:
                      verdict = None
                  reasons = payload.get("reasons")
                  if isinstance(reasons, list):
                      reasoning = "; ".join(str(r) for r in reasons) if reasons else None
                  else:
                      reasoning = reasons
                  return verdict, reasoning

              if "ok" in payload or "message" in payload:
                  return ("Correct" if payload.get("ok") else None), payload.get("message")

              return None, payload.get("error_note")


          def _build_recheck_lookup(y_output: Any) -> dict:
              """
              results.y.output is either:
                - the literal string "[]" when the recheck agent was skipped, or
                - {"results": [{"Agent": ..., "Reason": ..., "Final Verdict": ...}, ...]}
                  when it ran.
              """
              parsed = _parse(y_output)

              if isinstance(parsed, dict):
                  items = parsed.get("results") or []
              elif isinstance(parsed, list):
                  items = parsed
              else:
                  items = []

              lookup = {}
              for item in items:
                  if isinstance(item, dict) and item.get("Agent"):
                      canonical_name = _canonical_agent_name(item["Agent"])
                      lookup[canonical_name] = item
              return lookup


          def main(x: Any, w: Any = None, y_output: Any = None, offer_id: Any =
          None):
              parsed = _parse(x)

              if isinstance(parsed, dict):
                  summary = parsed.get("summary") or {}
                  buyer_viewed = summary.get("buyer_viewed") or {}
                  final_output = {
                      "offer_id": offer_id,
                      "verdict": parsed.get("verdict"),
                      "reasoning": parsed.get("reasoning"),
                  }
              else:
                  final_output = {"offer_id": offer_id, "output": parsed}

              # ------------------------------------------------------------------
              # Per-agent verdict + reasoning, built from the Parsing (w) node and,
              # for the four product-validation agents that were flagged incorrect,
              # overridden by the recheck agent (y1) output when it ran.
              # ------------------------------------------------------------------
              w_parsed = _parse(w)
              w_correct = w_parsed.get("correct") or {} if isinstance(w_parsed, dict) else {}
              w_incorrect = w_parsed.get("incorrect") or {} if isinstance(w_parsed, dict) else {}

              recheck_lookup = _build_recheck_lookup(y_output)

              agent_results = {}

              # Agents already in the "correct" bucket: use their own verdict/reasoning.
              for agent_name, payload in w_correct.items():
                  verdict, reasoning = _extract_verdict_reasoning(payload)
                  agent_results[agent_name] = {
                      "verdict": verdict,
                      "reasoning": reasoning,
                      "source": "parsing",
                  }

              # Agents in the "incorrect" bucket: prefer the recheck agent's verdict
              # if it ran for that agent, else fall back to the original w-node verdict.
              for agent_name, payload in w_incorrect.items():
                  recheck_entry = recheck_lookup.get(agent_name)

                  if recheck_entry:
                      agent_results[agent_name] = {
                          "verdict": recheck_entry.get("Final Verdict"),
                          "reasoning": recheck_entry.get("Reason"),
                          "source": "recheck",
                      }
                  else:
                      verdict, reasoning = _extract_verdict_reasoning(payload)
                      agent_results[agent_name] = {
                          "verdict": verdict,
                          "reasoning": reasoning,
                          "source": "parsing",
                      }

              final_output["agent_results"] = agent_results

              return final_output
        language: python3
        input_transforms:
          w:
            expr: results.w
            type: javascript
          x:
            expr: results.t.output
            type: javascript
          offer_id:
            expr: flow_input.offer_id
            type: javascript
          y_output:
            expr: results.y.output
            type: javascript
      summary: Final_structured

            modules:
              - id: y1
                value:
                  type: aiagent
                  tools: []
                  input_transforms:
                    provider:
                      type: static
                      value:
                        kind: customai
                        model: deepseek/deepseek-v4-flash
                        resource: $res:u/anuragupadhyay2/inspirational_customai
                    output_type:
                      type: static
                      value: text
                    user_message:
                      expr: "`Incorrect_agent: ${JSON.stringify(results.w.incorrect)}, Title:
                        ${results.i.RESPONSE.DATA.ETO_OFR_TITLE}, MCAT:
                        ${results.i.RESPONSE.DATA.PRIME_MCAT_NAME},
                        Desc:${results.i.RESPONSE.DATA.ETO_OFR_DESC}, ISQs:
                        ${results.i.RESPONSE.DATA.ENRICHMENTINFO},
